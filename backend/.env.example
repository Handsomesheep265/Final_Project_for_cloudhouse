# 后端环境变量示例
# 复制为 backend/.env 后按本地实际情况填写（.env 不要提交到仓库）

# HTTP 服务端口
PORT=3000

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=journal_bazaar
# 连接池大小，可选，默认 10
DB_POOL_SIZE=10

# 登录凭证（JWT / HS256）签名密钥
# 开发环境不填也能跑（代码里有仅供本地的默认值）；生产环境必须配置，且至少 32 个字符
# 生成：node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# 登录有效期（小时），默认 168 = 7 天；每次打开应用调 /api/auth/me 会顺延
AUTH_TOKEN_TTL_HOURS=168
# 前端站点地址：拼「找回密码」邮件里的重置链接用（生产环境改成真实域名）
APP_WEB_ORIGIN=http://127.0.0.1:5173
# 重置密码链接有效期（分钟），默认 30
AUTH_RESET_TTL_MINUTES=30
